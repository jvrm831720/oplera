# HubSpot private app
HUBSPOT_ACCESS_TOKEN=
# Explicit pilot allowlist. Only these deal IDs can be read/written by the adapter.
HUBSPOT_DEAL_IDS=123456789
HUBSPOT_RECOVERY_STATUS_PROPERTY=oplera_recovery_status
HUBSPOT_RECOVERY_ATTEMPTS_PROPERTY=oplera_recovery_attempts
HUBSPOT_ACTIVE_HUMAN_PROPERTY=oplera_active_human_conversation
HUBSPOT_LOST_REASON_PROPERTY=closed_lost_reason
HUBSPOT_NOTE_TO_DEAL_ASSOCIATION_TYPE_ID=214

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_APP_SECRET=
# Set explicitly to a Graph API version supported by your Meta app.
WHATSAPP_GRAPH_VERSION=vXX.X
# Approved template with exactly one BODY text variable: contact first name.
WHATSAPP_TEMPLATE_NAME=oplera_recovery_reactivation
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Pilot safety controls
# Store E.164 numbers. The provider refuses any number not present here.
PILOT_PHONE_ALLOWLIST=+5511999999999
# Keep both true until the dry-run review is complete.
PILOT_DRY_RUN=true
PILOT_KILL_SWITCH=true
# Used only by pilot admin endpoints. Minimum 32 characters.
PILOT_ADMIN_TOKEN=
PILOT_STATE_DB_PATH=.oplera/pilot-state.sqlite
